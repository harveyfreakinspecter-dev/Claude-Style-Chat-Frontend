# Qwen3 chatbot backend the api-server proxies /api/chat/* to.
CHATBOT_API_URL=https://chatbot.discoveryez-test.online
CHATBOT_API_KEY=

# Port the Express server listens on (behind nginx in production).
PORT=5000

# Restrict CORS to the deployed frontend origin. Leave unset for local dev.
ALLOWED_ORIGIN=https://ai.discoveryez-test.online
